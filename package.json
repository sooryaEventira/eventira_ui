{
  "name": "puck-editor-learning",
  "version": "1.0.0",
  "description": "A simple React project for learning Puck editor",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs=require('fs');const p='.'; const dirs=['node_modules/.vite','build','dist']; dirs.forEach(d=>{ try { fs.rmSync(d,{recursive:true}); console.log('Removed '+d); } catch(e) {} });\"",
    "build": "vite build && node -e \"require('fs').copyFileSync('staticwebapp.config.json', 'build/staticwebapp.config.json')\"",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "server": "node server.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@measured/puck": "^0.20.1",
    "@meysam213/iconsax-react": "^1.0.4",
    "@untitled-ui/icons-react": "^0.1.4",
    "ably": "^2.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "iconsax-react": "^0.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-quill": "^2.0.0",
    "react-select": "^5.8.0",
    "react-time-picker": "^8.0.2",
    "survey-core": "^2.3.7",
    "survey-react-ui": "^2.3.7",
    "tailwind-merge": "^3.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.14",
    "terser": "^5.44.1",
    "vite": "^5.4.10"
  },
  "keywords": [
    "react",
    "puck",
    "editor",
    "learning"
  ],
  "author": "",
  "license": "MIT"
}
